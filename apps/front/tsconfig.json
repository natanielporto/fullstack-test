{
  "extends": "../../packages/typescript-config/tsconfig.next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@mosano-test-fullstack/vitest-config": [
        "../../packages/vitest-config/vitest.config.ts"
      ]
    },
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "module": "esnext",
    "jsx": "preserve"
  },
  "include": [
    "src/**/*",
    ".next/types/**/*.ts",
    "src/types/global.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
