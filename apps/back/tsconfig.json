{
  "extends": "../../packages/typescript-config/tsconfig.node.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@mosano-test-fullstack/*": ["../../packages/*/dist"]
    },
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*", "src", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
