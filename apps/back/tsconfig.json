{
  "extends": "../../packages/typescript-config/tsconfig.node.json",
  "compilerOptions": {
    "types": ["vitest"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@mosano-test-fullstack/vitest-config": ["packages/vitest-config"],
      "@/*": ["apps/back/src/*"]
    },
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["node_modules"]
}
