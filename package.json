{
  "name": "mosano-test-fullstack",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "test -f node_modules/.bin/husky && husky install || echo 'Husky not installed yet.'",
    "setup": "echo 'Setup script running...'",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@eslint/json": "^0.12.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "turbo": "^2.5.3",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.32.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2+sha512.8ab88f10f224a0c614cb717a7f7c30499014f77134120e9c1f0211ea3cf3397592cbe483feb38e0c4b3be1c54e347292c76a1b5edb94a3289d5448484ab8ac81",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged"
    }
  },
  "lint-staged": {
    "apps/front/src/**/*.{js,jsx,ts,tsx}": [
      "eslint --config apps/front/eslint.config.js --fix"
    ],
    "apps/back/**/*.ts": [
      "eslint --config apps/back/eslint.config.js --fix",
      "npm run test --workspace=back --cwd apps/back"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
