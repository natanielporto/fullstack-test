{
  "name": "mosano-test-fullstack",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "config": {
    "husky": {
      "hooks": {
        "pre-commit": "npx lint-staged"
      }
    },
    "lint-staged": {
      "*.{js,ts,tsx}": [
        "eslint --fix",
        "npm run test -- --bail --findRelatedTests"
      ],
      "*.{json,md,css}": [
        "prettier --write"
      ]
    }
  }
}
